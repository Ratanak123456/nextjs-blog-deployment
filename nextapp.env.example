# Copy is installed at /etc/nextapp/nextapp.env by the setup script.
# Edit there with sudoedit. Next.js reads it through .env.production.
# These are placeholders. Match the variables your application actually uses.
DATABASE_URL="postgresql://APP_USER:CHANGE_ME@DB_SERVER_IP:5432/APP_DATABASE"

